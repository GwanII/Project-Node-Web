import { NextResponse } from "next/server";
import { createServerSupabaseClient } from "@/src/lib/supabase-server";
import { supabaseAdmin } from "@/src/lib/supabase-admin";

export async function GET() {
  const supabase = await createServerSupabaseClient();
  const {
    data: { user },
  } = await supabase.auth.getUser();

  if (!user) {
    return NextResponse.json({ error: "로그인이 필요합니다." }, { status: 401 });
  }

  const { data: requesterProfile } = await supabaseAdmin
    .from("profiles")
    .select("is_admin")
    .eq("id", user.id)
    .single();

  if (!requesterProfile?.is_admin) {
    return NextResponse.json({ error: "관리자만 접근할 수 있습니다." }, { status: 403 });
  }

  const [
    { count: userCount },
    { count: projectCount },
    { count: pendingInviteCount },
    { count: acceptedInviteCount },
    { data: users },
    { data: projects },
  ] = await Promise.all([
    supabaseAdmin.from("profiles").select("*", { count: "exact", head: true }),
    supabaseAdmin.from("projectdata").select("*", { count: "exact", head: true }),
    supabaseAdmin
      .from("project_invites")
      .select("*", { count: "exact", head: true })
      .eq("status", "pending"),
    supabaseAdmin
      .from("project_invites")
      .select("*", { count: "exact", head: true })
      .eq("status", "accepted"),
    supabaseAdmin
      .from("profiles")
      .select("id, name, nickname, email, is_admin, created_at")
      .order("created_at", { ascending: false })
      .limit(200),
    supabaseAdmin
      .from("projectdata")
      .select("id, project_name, user_name, user_email, created_at, end_date, project_members(count)")
      .order("created_at", { ascending: false })
      .limit(200),
  ]);

  return NextResponse.json({
    stats: {
      userCount: userCount ?? 0,
      projectCount: projectCount ?? 0,
      pendingInviteCount: pendingInviteCount ?? 0,
      acceptedInviteCount: acceptedInviteCount ?? 0,
    },
    users: users ?? [],
    projects: (projects ?? []).map((p) => ({
      id: p.id,
      projectName: p.project_name,
      leaderName: p.user_name,
      leaderEmail: p.user_email,
      createdAt: p.created_at,
      endDate: p.end_date,
      memberCount: (p.project_members as unknown as { count: number }[] | null)?.[0]?.count ?? 0,
    })),
  });
}
